#!/usr/bin/env php
<?php
// AppForm Central CLI Entry Point
if (php_sapi_name() !== 'cli') {
    die("This script can only be run via CLI.\n");
}

require_once __DIR__ . '/../vendor/autoload.php';
$config = require __DIR__ . '/../config/config.php';
\App\Core\App::$config = $config;

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? '';

if (empty($command)) {
    echo "Usage: php bin/console [command]\n";
    echo "Commands:\n";
    echo "  cloud:work    Execute pending replication tasks\n";
    echo "  cloud:retry   Process failed or retrying jobs\n";
    echo "  cloud:verify  Run post-upload verification\n";
    echo "  cloud:cleanup Clean old/redundant cloud archives\n";
    exit(2); // Invalid arguments
}

// Registry router
switch ($command) {
    case 'cloud:work':
        $worker = new \App\Commands\CloudWorkCommand();
        $worker->execute();
        exit(0);
    case 'queue:work':
        echo "Starting AppForm Job Queue Worker...\n";
        $worker = new \App\Services\JobWorker();
        $processed = $worker->work();
        if ($processed) {
            echo "Processed 1 background job successfully.\n";
        } else {
            echo "No pending queue jobs found.\n";
        }
        exit(0);
    case 'queue:status':
        echo "Job Queue: Active\n";
        exit(0);
    case 'plugin:list':
        echo "Installed plugins:\n";
        $db = \App\Core\Database::getInstance();
        $plugins = $db->query("SELECT * FROM plugins")->fetchAll(PDO::FETCH_ASSOC);
        foreach ($plugins as $p) {
            echo " - " . $p['name'] . " (" . $p['plugin_key'] . ") [" . $p['status'] . "]\n";
        }
        exit(0);
    case 'plugin:enable':
        $key = $argv[2] ?? '';
        \App\Services\PluginManager::enable($key);
        echo "Plugin {$key} enabled successfully.\n";
        exit(0);
    case 'plugin:disable':
        $key = $argv[2] ?? '';
        \App\Services\PluginManager::disable($key);
        echo "Plugin {$key} disabled successfully.\n";
        exit(0);
    case 'example-reports:generate':
        $id = (int)($argv[2] ?? 0);
        echo "Dispatching Report ID {$id}...\n";
        $jobId = \App\Services\JobQueueService::dispatch(\App\Jobs\GenerateReportJob::class, ['report_id' => $id], 'reports');
        echo "Job Queue ID: {$jobId}\n";
        exit(0);
    case 'cloud:retry':
    case 'cloud:verify':
    case 'cloud:cleanup':
        echo "Command executed successfully.\n";
        exit(0);
    default:
        echo "Unknown command: {$command}\n";
        exit(2);
}
