/* =====================================================================
   AppForm Enterprise UI — Design System
   CSS Custom Properties + Light/Dark Themes + Enterprise Components
   ===================================================================== */

/* ── Google Fonts ──────────────────────────────────────────────────── */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ── CSS Reset & Base ──────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }

/* =====================================================================
   LIGHT THEME (default)
   ===================================================================== */
:root,
[data-theme="light"] {
  /* Surfaces */
  --color-bg:          #F8FAFC;
  --color-surface:     #FFFFFF;
  --color-card:        #FFFFFF;
  --color-sidebar:     #F1F5F9;
  --color-navbar:      #FFFFFF;
  --color-input-bg:    #F8FAFC;

  /* Borders */
  --color-border:      #E5E7EB;
  --color-border-focus:#4F46E5;

  /* Brand */
  --color-primary:     #4F46E5;
  --color-primary-hover:#4338CA;
  --color-primary-light:rgba(79, 70, 229, 0.10);
  --color-primary-glow: rgba(79, 70, 229, 0.25);

  /* Semantic */
  --color-success:     #16A34A;
  --color-success-bg:  rgba(22, 163, 74, 0.10);
  --color-warning:     #F59E0B;
  --color-warning-bg:  rgba(245, 158, 11, 0.10);
  --color-danger:      #EF4444;
  --color-danger-bg:   rgba(239, 68, 68, 0.10);
  --color-info:        #0EA5E9;
  --color-info-bg:     rgba(14, 165, 233, 0.10);

  /* Text */
  --color-text:        #111827;
  --color-text-soft:   #374151;
  --color-text-muted:  #6B7280;
  --color-text-placeholder: #9CA3AF;
  --color-text-inverse:#FFFFFF;

  /* Shadows */
  --shadow-xs:  0 1px 2px 0 rgba(0,0,0,0.05);
  --shadow-sm:  0 1px 3px 0 rgba(0,0,0,0.10), 0 1px 2px -1px rgba(0,0,0,0.10);
  --shadow-md:  0 4px 6px -1px rgba(0,0,0,0.10), 0 2px 4px -2px rgba(0,0,0,0.10);
  --shadow-lg:  0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -4px rgba(0,0,0,0.10);
  --shadow-xl:  0 20px 25px -5px rgba(0,0,0,0.10), 0 8px 10px -6px rgba(0,0,0,0.10);

  /* Sidebar active */
  --sidebar-active-bg:     var(--color-primary-light);
  --sidebar-active-color:  var(--color-primary);
  --sidebar-active-border: var(--color-primary);
  --sidebar-hover-bg:      rgba(0,0,0,0.04);
  --sidebar-text:          #475569;
  --sidebar-section-text:  #94A3B8;

  /* Table */
  --table-header-bg:   #F1F5F9;
  --table-header-text: #374151;
  --table-row-bg:      #FFFFFF;
  --table-row-alt:     #F8FAFC;
  --table-row-hover:   #EEF2FF;
  --table-border:      #E5E7EB;
  --table-text:        #111827;

  /* Status badges */
  --badge-admin-bg:    rgba(79, 70, 229, 0.12);
  --badge-admin-text:  #4338CA;
  --badge-manager-bg:  rgba(139, 92, 246, 0.12);
  --badge-manager-text:#7C3AED;
  --badge-reviewer-bg: rgba(245, 158, 11, 0.12);
  --badge-reviewer-text:#B45309;
  --badge-user-bg:     rgba(22, 163, 74, 0.12);
  --badge-user-text:   #15803D;

  /* Misc */
  --radius-sm:  6px;
  --radius-md:  10px;
  --radius-lg:  14px;
  --radius-xl:  18px;
  --radius-pill:9999px;
  --transition: all 0.15s ease;
  --font-base:  'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
}

/* =====================================================================
   DARK THEME
   ===================================================================== */
[data-theme="dark"] {
  --color-bg:          #111827;
  --color-surface:     #1F2937;
  --color-card:        #1F2937;
  --color-sidebar:     #1E293B;
  --color-navbar:      #1F2937;
  --color-input-bg:    #111827;

  --color-border:      #374151;
  --color-border-focus:#6366F1;

  --color-primary:     #6366F1;
  --color-primary-hover:#818CF8;
  --color-primary-light:rgba(99, 102, 241, 0.15);
  --color-primary-glow: rgba(99, 102, 241, 0.30);

  --color-success:     #22C55E;
  --color-success-bg:  rgba(34, 197, 94, 0.12);
  --color-warning:     #F59E0B;
  --color-warning-bg:  rgba(245, 158, 11, 0.12);
  --color-danger:      #EF4444;
  --color-danger-bg:   rgba(239, 68, 68, 0.12);
  --color-info:        #38BDF8;
  --color-info-bg:     rgba(56, 189, 248, 0.12);

  --color-text:        #F3F4F6;
  --color-text-soft:   #D1D5DB;
  --color-text-muted:  #9CA3AF;
  --color-text-placeholder: #6B7280;
  --color-text-inverse:#111827;

  --shadow-xs:  0 1px 2px 0 rgba(0,0,0,0.30);
  --shadow-sm:  0 1px 3px 0 rgba(0,0,0,0.40), 0 1px 2px -1px rgba(0,0,0,0.30);
  --shadow-md:  0 4px 6px -1px rgba(0,0,0,0.40), 0 2px 4px -2px rgba(0,0,0,0.30);
  --shadow-lg:  0 10px 15px -3px rgba(0,0,0,0.45), 0 4px 6px -4px rgba(0,0,0,0.35);
  --shadow-xl:  0 20px 25px -5px rgba(0,0,0,0.50), 0 8px 10px -6px rgba(0,0,0,0.40);

  --sidebar-active-bg:     rgba(99, 102, 241, 0.18);
  --sidebar-active-color:  #818CF8;
  --sidebar-active-border: #6366F1;
  --sidebar-hover-bg:      rgba(255,255,255,0.05);
  --sidebar-text:          #94A3B8;
  --sidebar-section-text:  #4B5563;

  --table-header-bg:   #273449;
  --table-header-text: #F3F4F6;
  --table-row-bg:      #1F2937;
  --table-row-alt:     #243244;
  --table-row-hover:   #2D4059;
  --table-border:      #374151;
  --table-text:        #F3F4F6;

  --badge-admin-bg:    rgba(99, 102, 241, 0.20);
  --badge-admin-text:  #A5B4FC;
  --badge-manager-bg:  rgba(167, 139, 250, 0.20);
  --badge-manager-text:#C4B5FD;
  --badge-reviewer-bg: rgba(245, 158, 11, 0.15);
  --badge-reviewer-text:#FCD34D;
  --badge-user-bg:     rgba(34, 197, 94, 0.15);
  --badge-user-text:   #86EFAC;
}

/* ── System preference fallback ────────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]):not([data-theme="dark"]) {
    --color-bg:          #111827;
    --color-surface:     #1F2937;
    --color-card:        #1F2937;
    --color-sidebar:     #1E293B;
    --color-navbar:      #1F2937;
    --color-input-bg:    #111827;
    --color-border:      #374151;
    --color-border-focus:#6366F1;
    --color-primary:     #6366F1;
    --color-primary-hover:#818CF8;
    --color-primary-light:rgba(99,102,241,0.15);
    --color-primary-glow:rgba(99,102,241,0.30);
    --color-success:     #22C55E;
    --color-success-bg:  rgba(34,197,94,0.12);
    --color-warning:     #F59E0B;
    --color-warning-bg:  rgba(245,158,11,0.12);
    --color-danger:      #EF4444;
    --color-danger-bg:   rgba(239,68,68,0.12);
    --color-info:        #38BDF8;
    --color-info-bg:     rgba(56,189,248,0.12);
    --color-text:        #F3F4F6;
    --color-text-soft:   #D1D5DB;
    --color-text-muted:  #9CA3AF;
    --color-text-placeholder:#6B7280;
    --color-text-inverse:#111827;
    --shadow-xs: 0 1px 2px 0 rgba(0,0,0,0.30);
    --shadow-sm: 0 1px 3px 0 rgba(0,0,0,0.40);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.40);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.45);
    --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.50);
    --sidebar-active-bg:    rgba(99,102,241,0.18);
    --sidebar-active-color: #818CF8;
    --sidebar-active-border:#6366F1;
    --sidebar-hover-bg:     rgba(255,255,255,0.05);
    --sidebar-text:         #94A3B8;
    --sidebar-section-text: #4B5563;
    --table-header-bg:      #273449;
    --table-header-text:    #F3F4F6;
    --table-row-bg:         #1F2937;
    --table-row-alt:        #243244;
    --table-row-hover:      #2D4059;
    --table-border:         #374151;
    --table-text:           #F3F4F6;
    --badge-admin-bg:       rgba(99,102,241,0.20);
    --badge-admin-text:     #A5B4FC;
    --badge-manager-bg:     rgba(167,139,250,0.20);
    --badge-manager-text:   #C4B5FD;
    --badge-reviewer-bg:    rgba(245,158,11,0.15);
    --badge-reviewer-text:  #FCD34D;
    --badge-user-bg:        rgba(34, 197, 94, 0.15);
    --badge-user-text:      #86EFAC;
  }
}


/* =====================================================================
   BASE ELEMENTS
   ===================================================================== */
html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-base);
  font-size: 0.9375rem;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
  transition: background-color 0.20s ease, color 0.20s ease;
}

h1, h2, h3, h4, h5, h6 {
  color: var(--color-text) !important;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 0;
}

a { color: var(--color-primary); text-decoration: none; }
a:hover { color: var(--color-primary-hover); }

/* ── Scrollbar ─────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-primary); }

/* =====================================================================
   LAYOUT
   ===================================================================== */
.app-container {
  display: flex;
  min-height: 100vh;
}

/* =====================================================================
   SIDEBAR
   ===================================================================== */
.sidebar {
  width: 264px;
  min-width: 264px;
  background: var(--color-sidebar);
  border-right: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  z-index: 1000;
  transition: transform 0.25s ease, background 0.20s ease, border-color 0.20s ease;
  overflow-y: auto;
  overflow-x: hidden;
}

.sidebar-header {
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--color-border);
  flex-shrink: 0;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.sidebar-logo-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, var(--color-primary), #7C3AED);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 16px;
  flex-shrink: 0;
  box-shadow: 0 2px 8px var(--color-primary-glow);
}

.sidebar-logo-text {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: -0.3px;
}

.sidebar-logo-text span {
  color: var(--color-primary);
}

.sidebar-body {
  flex: 1;
  padding: 12px 12px;
  overflow-y: auto;
}

/* Sidebar Sections */
.sidebar-section {
  margin-bottom: 4px;
}

.sidebar-section-title {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--sidebar-section-text);
  padding: 12px 8px 6px;
}

/* Nav Items */
.nav-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-item a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  color: var(--sidebar-text);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  border-radius: var(--radius-md);
  transition: var(--transition);
  position: relative;
  border-left: 2px solid transparent;
}

.nav-item a:hover {
  background: var(--sidebar-hover-bg);
  color: var(--color-text);
}

.nav-item.active a {
  background: var(--sidebar-active-bg);
  color: var(--sidebar-active-color);
  font-weight: 600;
  border-left-color: var(--sidebar-active-border);
}

.nav-item a .nav-icon {
  width: 18px;
  text-align: center;
  font-size: 14px;
  flex-shrink: 0;
}

.nav-item a .nav-label {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-item a .nav-badge {
  min-width: 20px;
  height: 20px;
  background: var(--color-danger);
  color: #fff;
  font-size: 0.6875rem;
  font-weight: 700;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6px;
}

/* Sidebar Footer */
.sidebar-footer {
  padding: 12px 12px 16px;
  border-top: 1px solid var(--color-border);
  flex-shrink: 0;
}

.sidebar-logout-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 9px 12px;
  background: transparent;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  text-align: left;
}

.sidebar-logout-btn:hover {
  background: var(--color-danger-bg);
  border-color: var(--color-danger);
  color: var(--color-danger);
}

/* Mobile toggle */
.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  backdrop-filter: blur(2px);
}

/* =====================================================================
   MAIN CONTENT
   ===================================================================== */
.main-content {
  flex: 1;
  margin-left: 264px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  transition: background 0.20s ease;
}

/* =====================================================================
   TOP NAVBAR / HEADER
   ===================================================================== */
.app-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-navbar);
  border-bottom: 1px solid var(--color-border);
  padding: 0 32px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition: background 0.20s ease, border-color 0.20s ease;
  box-shadow: var(--shadow-xs);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.header-page-title {
  font-size: 1.0625rem;
  font-weight: 600;
  color: var(--color-text) !important;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-page-subtitle {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin-top: 1px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* Mobile menu toggle */
.btn-mobile-menu {
  display: none;
  background: transparent;
  border: none;
  color: var(--color-text);
  font-size: 20px;
  cursor: pointer;
  padding: 6px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
}

.btn-mobile-menu:hover { background: var(--sidebar-hover-bg); }

/* Theme switcher */
.theme-switcher {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  padding: 3px;
}

.theme-btn {
  background: transparent;
  border: none;
  width: 30px;
  height: 30px;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  cursor: pointer;
  font-size: 13px;
  transition: var(--transition);
}

.theme-btn:hover { color: var(--color-text); }

.theme-btn.active {
  background: var(--color-surface);
  color: var(--color-primary);
  box-shadow: var(--shadow-sm);
}

/* User avatar */
.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--color-primary), #7C3AED);
  color: #fff;
  font-size: 0.8125rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  text-transform: uppercase;
}

.user-info-block {
  text-align: right;
  line-height: 1.3;
}

.user-info-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text);
}

.user-info-role {
  font-size: 0.75rem;
  color: var(--color-text-muted);
}

/* Icon button */
.btn-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 14px;
  transition: var(--transition);
  text-decoration: none;
  position: relative;
}

.btn-icon:hover {
  background: var(--color-surface);
  color: var(--color-text);
}

.btn-icon .notif-dot {
  position: absolute;
  top: 5px;
  right: 5px;
  width: 8px;
  height: 8px;
  background: var(--color-danger);
  border-radius: 50%;
  border: 2px solid var(--color-navbar);
}

/* =====================================================================
   WORKSPACE AREA
   ===================================================================== */
.workspace-area {
  flex: 1;
  padding: 28px 32px 40px;
}

/* Page Header Block */
.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.page-header-left .page-title {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--color-text) !important;
  line-height: 1.2;
}

.page-header-left .page-subtitle {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  margin-top: 4px;
}

.page-header-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* =====================================================================
   CARDS
   ===================================================================== */
.card {
  background: var(--color-card) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-sm) !important;
  transition: var(--transition), box-shadow 0.20s ease !important;
}

.card:hover {
  box-shadow: var(--shadow-md) !important;
}

.card-header {
  background: transparent !important;
  border-bottom: 1px solid var(--color-border) !important;
  padding: 16px 20px !important;
}

.card-body {
  padding: 20px !important;
  color: var(--color-text) !important;
}

/* KPI Cards */
.kpi-card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 20px 22px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-sm);
  transition: var(--transition), box-shadow 0.20s ease;
  position: relative;
  overflow: hidden;
}

.kpi-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--kpi-color, var(--color-primary)), transparent);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.kpi-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.kpi-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: var(--kpi-color-bg, var(--color-primary-light));
  color: var(--kpi-color, var(--color-primary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.kpi-body { flex: 1; min-width: 0; }

.kpi-value {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.1;
}

.kpi-label {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  margin-top: 3px;
}

.kpi-trend {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
}

.kpi-trend.up { background: var(--color-success-bg); color: var(--color-success); }
.kpi-trend.down { background: var(--color-danger-bg); color: var(--color-danger); }

/* =====================================================================
   TABLES
   ===================================================================== */
.table-wrapper {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.table-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--color-border);
  gap: 12px;
  flex-wrap: wrap;
}

.table-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-text);
}

.table-search-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.table-responsive { overflow-x: auto; }

.table {
  width: 100%;
  margin: 0 !important;
  border-collapse: collapse;
  color: var(--table-text) !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
}

.table thead th {
  background: var(--table-header-bg) !important;
  color: var(--table-header-text) !important;
  font-size: 0.75rem !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  padding: 11px 16px !important;
  border-bottom: 1px solid var(--table-border) !important;
  border-top: none !important;
  white-space: nowrap;
}

.table tbody tr {
  background: var(--table-row-bg) !important;
  transition: background 0.12s ease !important;
}

.table tbody tr:nth-child(even) {
  background: var(--table-row-alt) !important;
}

.table tbody tr:hover {
  background: var(--table-row-hover) !important;
}

.table td {
  padding: 12px 16px !important;
  border-bottom: 1px solid var(--table-border) !important;
  border-top: none !important;
  vertical-align: middle;
  color: var(--table-text) !important;
  font-size: 0.875rem;
}

.table tbody tr:last-child td {
  border-bottom: none !important;
}

/* =====================================================================
   FORMS
   ===================================================================== */
.form-label {
  font-size: 0.8125rem !important;
  font-weight: 600 !important;
  color: var(--color-text-soft) !important;
  margin-bottom: 6px !important;
}

.form-control,
.form-select {
  background-color: var(--color-input-bg) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-md) !important;
  color: var(--color-text) !important;
  font-size: 0.9375rem !important;
  padding: 10px 14px !important;
  transition: border-color 0.15s ease, box-shadow 0.15s ease !important;
}

.form-control::placeholder { color: var(--color-text-placeholder) !important; }

.form-control:focus,
.form-select:focus {
  background-color: var(--color-input-bg) !important;
  border-color: var(--color-border-focus) !important;
  box-shadow: 0 0 0 3px var(--color-primary-glow) !important;
  outline: none !important;
  color: var(--color-text) !important;
}

.form-control:disabled,
.form-select:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-text {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin-top: 4px;
}

.form-check-input:checked {
  background-color: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

.input-group-text {
  background: var(--color-surface) !important;
  border-color: var(--color-border) !important;
  color: var(--color-text-muted) !important;
}

/* =====================================================================
   BUTTONS
   ===================================================================== */
.btn {
  font-weight: 500;
  font-size: 0.875rem;
  border-radius: var(--radius-md) !important;
  padding: 9px 18px;
  transition: var(--transition) !important;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.btn-sm {
  padding: 6px 14px !important;
  font-size: 0.8125rem !important;
}

.btn-lg {
  padding: 12px 24px !important;
  font-size: 1rem !important;
}

.btn-primary {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  color: #fff !important;
  box-shadow: 0 1px 3px var(--color-primary-glow) !important;
}

.btn-primary:hover, .btn-primary:focus {
  background: var(--color-primary-hover) !important;
  border-color: var(--color-primary-hover) !important;
  box-shadow: 0 3px 8px var(--color-primary-glow) !important;
  transform: translateY(-1px);
}

.btn-outline-primary {
  color: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  background: transparent !important;
}

.btn-outline-primary:hover {
  background: var(--color-primary-light) !important;
  color: var(--color-primary) !important;
}

.btn-secondary {
  background: var(--color-surface) !important;
  border-color: var(--color-border) !important;
  color: var(--color-text) !important;
}

.btn-secondary:hover {
  background: var(--color-border) !important;
}

.btn-danger {
  background: var(--color-danger) !important;
  border-color: var(--color-danger) !important;
  color: #fff !important;
}

.btn-danger:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

.btn-outline-danger {
  color: var(--color-danger) !important;
  border-color: var(--color-danger) !important;
  background: transparent !important;
}

.btn-outline-danger:hover {
  background: var(--color-danger-bg) !important;
}

.btn-success {
  background: var(--color-success) !important;
  border-color: var(--color-success) !important;
  color: #fff !important;
}

.btn-outline-success {
  color: var(--color-success) !important;
  border-color: var(--color-success) !important;
  background: transparent !important;
}

.btn-outline-success:hover {
  background: var(--color-success-bg) !important;
  color: var(--color-success) !important;
}

.btn-warning {
  background: var(--color-warning) !important;
  border-color: var(--color-warning) !important;
  color: var(--color-text-inverse) !important;
}

.btn-info {
  background: var(--color-info) !important;
  border-color: var(--color-info) !important;
  color: #fff !important;
}

.btn-outline-info {
  color: var(--color-info) !important;
  border-color: var(--color-info) !important;
  background: transparent !important;
}

.btn-outline-info:hover {
  background: var(--color-info-bg) !important;
  color: var(--color-info) !important;
}

/* Premium button */
.btn-premium {
  background: linear-gradient(135deg, var(--color-primary), #7C3AED) !important;
  border: none !important;
  color: #fff !important;
  font-weight: 600 !important;
  box-shadow: 0 2px 10px var(--color-primary-glow) !important;
}

.btn-premium:hover {
  box-shadow: 0 4px 16px var(--color-primary-glow) !important;
  transform: translateY(-1px);
  color: #fff !important;
}

/* =====================================================================
   BADGES
   ===================================================================== */
.badge {
  font-size: 0.6875rem !important;
  font-weight: 600 !important;
  padding: 4px 10px !important;
  border-radius: var(--radius-pill) !important;
  letter-spacing: 0.02em;
}

/* Status badges */
.badge-status-draft      { background: var(--color-info-bg);    color: var(--color-info);    }
.badge-status-submitted  { background: var(--color-warning-bg); color: var(--color-warning); }
.badge-status-review     { background: var(--color-warning-bg); color: var(--color-warning); }
.badge-status-approved   { background: var(--color-success-bg); color: var(--color-success); }
.badge-status-rejected   { background: var(--color-danger-bg);  color: var(--color-danger);  }
.badge-status-published  { background: var(--color-success-bg); color: var(--color-success); }
.badge-status-archived   { background: var(--color-surface);    color: var(--color-text-muted); border: 1px solid var(--color-border); }

/* Role badges */
.badge-role-administrator { background: var(--badge-admin-bg);    color: var(--badge-admin-text);    }
.badge-role-manager       { background: var(--badge-manager-bg);  color: var(--badge-manager-text);  }
.badge-role-reviewer      { background: var(--badge-reviewer-bg); color: var(--badge-reviewer-text); }
.badge-role-user          { background: var(--badge-user-bg);     color: var(--badge-user-text);     }

/* Bootstrap badge overrides */
.bg-success { background-color: var(--color-success) !important; }
.bg-danger  { background-color: var(--color-danger)  !important; }
.bg-warning { background-color: var(--color-warning) !important; color: var(--color-text-inverse) !important; }
.bg-info    { background-color: var(--color-info)    !important; }
.bg-primary { background-color: var(--color-primary) !important; }
.bg-secondary { background-color: var(--color-surface) !important; color: var(--color-text-muted) !important; border: 1px solid var(--color-border); }

/* =====================================================================
   ALERTS
   ===================================================================== */
.alert {
  border-radius: var(--radius-md) !important;
  border: 1px solid transparent !important;
  font-size: 0.875rem;
  padding: 12px 16px !important;
}

.alert-danger {
  background: var(--color-danger-bg) !important;
  border-color: rgba(239,68,68,0.25) !important;
  color: var(--color-danger) !important;
}

.alert-success {
  background: var(--color-success-bg) !important;
  border-color: rgba(22,163,74,0.25) !important;
  color: var(--color-success) !important;
}

.alert-warning {
  background: var(--color-warning-bg) !important;
  border-color: rgba(245,158,11,0.25) !important;
  color: var(--color-warning) !important;
}

.alert-info {
  background: var(--color-info-bg) !important;
  border-color: rgba(14,165,233,0.25) !important;
  color: var(--color-info) !important;
}

/* =====================================================================
   MODALS
   ===================================================================== */
.modal-content {
  background: var(--color-card) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-xl) !important;
  box-shadow: var(--shadow-xl) !important;
  color: var(--color-text) !important;
}

.modal-header {
  border-bottom: 1px solid var(--color-border) !important;
  padding: 18px 22px !important;
}

.modal-footer {
  border-top: 1px solid var(--color-border) !important;
  padding: 14px 22px !important;
}

.modal-body { padding: 20px 22px !important; }

.modal-title {
  font-size: 1.0625rem !important;
  font-weight: 600 !important;
  color: var(--color-text) !important;
}

.btn-close { filter: var(--btn-close-filter, none); }
[data-theme="dark"] .btn-close { filter: invert(1); }

.modal-backdrop.show { backdrop-filter: blur(4px); }

/* =====================================================================
   DROPDOWNS
   ===================================================================== */
.dropdown-menu {
  background: var(--color-card) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-lg) !important;
  padding: 6px !important;
  color: var(--color-text) !important;
}

.dropdown-item {
  border-radius: var(--radius-sm) !important;
  color: var(--color-text-soft) !important;
  font-size: 0.875rem !important;
  padding: 8px 12px !important;
  transition: var(--transition) !important;
  display: flex;
  align-items: center;
  gap: 8px;
}

.dropdown-item:hover {
  background: var(--sidebar-hover-bg) !important;
  color: var(--color-text) !important;
}

.dropdown-divider {
  border-color: var(--color-border) !important;
  margin: 4px 0 !important;
}

/* =====================================================================
   PAGINATION
   ===================================================================== */
.pagination .page-link {
  background: var(--color-card) !important;
  border-color: var(--color-border) !important;
  color: var(--color-text-soft) !important;
  font-size: 0.875rem;
  transition: var(--transition);
}

.pagination .page-link:hover {
  background: var(--color-primary-light) !important;
  color: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

.pagination .page-item.active .page-link {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  color: #fff !important;
}

.pagination .page-item.disabled .page-link {
  background: var(--color-surface) !important;
  color: var(--color-text-muted) !important;
}

/* =====================================================================
   AUTH PAGE
   ===================================================================== */
.auth-wrapper {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.auth-wrapper::before {
  content: '';
  position: fixed;
  top: -30%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, var(--color-primary-light), transparent 70%);
  pointer-events: none;
}

.auth-wrapper::after {
  content: '';
  position: fixed;
  bottom: -20%;
  right: -10%;
  width: 50%;
  height: 50%;
  background: radial-gradient(circle, rgba(124,58,237,0.08), transparent 70%);
  pointer-events: none;
}

.auth-card {
  width: 100%;
  max-width: 420px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 40px 36px;
  box-shadow: var(--shadow-xl);
  position: relative;
  z-index: 1;
}

.auth-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 28px;
}

.auth-logo-icon {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--color-primary), #7C3AED);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20px;
  box-shadow: 0 4px 12px var(--color-primary-glow);
}

.auth-logo-text {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: -0.5px;
}

.auth-title {
  font-size: 1.375rem !important;
  font-weight: 700 !important;
  color: var(--color-text) !important;
  text-align: center;
  margin-bottom: 6px;
}

.auth-subtitle {
  text-align: center;
  color: var(--color-text-muted);
  font-size: 0.875rem;
  margin-bottom: 28px;
}

/* =====================================================================
   EMPTY STATES
   ===================================================================== */
.empty-state {
  text-align: center;
  padding: 60px 24px;
  color: var(--color-text-muted);
}

.empty-state-icon {
  font-size: 3rem;
  margin-bottom: 16px;
  opacity: 0.4;
}

/* KPI and Stat Cards styling */
.stat-card {
  background: var(--color-card) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-lg) !important;
  padding: 24px !important;
  display: flex !important;
  align-items: center !important;
  gap: 20px !important;
  box-shadow: var(--shadow-sm) !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease !important;
}

.stat-card:hover {
  transform: translateY(-2px) !important;
  box-shadow: var(--shadow-md) !important;
}

.stat-card-icon {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  flex-shrink: 0;
}

.stat-primary {
  background: var(--color-primary-light) !important;
  color: var(--color-primary) !important;
}

.stat-info {
  background: var(--color-info-bg) !important;
  color: var(--color-info) !important;
}

.stat-success {
  background: var(--color-success-bg) !important;
  color: var(--color-success) !important;
}

.stat-card-info {
  flex: 1;
}

.stat-card-label {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  font-weight: 500;
  margin-bottom: 4px;
}

.stat-card-value {
  font-size: 1.875rem;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1;
}

/* =====================================================================
   MISC UTILITIES
   ===================================================================== */
.text-primary { color: var(--color-primary) !important; }
.text-success { color: var(--color-success) !important; }
.text-danger  { color: var(--color-danger)  !important; }
.text-warning { color: var(--color-warning) !important; }
.text-info    { color: var(--color-info)    !important; }
.text-muted   { color: var(--color-text-muted) !important; }

.border { border-color: var(--color-border) !important; }
.border-top    { border-top-color:    var(--color-border) !important; }
.border-bottom { border-bottom-color: var(--color-border) !important; }
.border-glass  { border-color: var(--color-border) !important; }

.bg-body    { background: var(--color-bg)      !important; }
.bg-surface { background: var(--color-surface) !important; }
.bg-card    { background: var(--color-card)    !important; }

/* Divider */
hr { border-color: var(--color-border) !important; opacity: 1; }

/* Nav tabs override */
.nav-tabs {
  border-bottom-color: var(--color-border) !important;
}
.nav-tabs .nav-link {
  color: var(--color-text-muted) !important;
  border-color: transparent !important;
  font-size: 0.875rem;
  font-weight: 500;
}
.nav-tabs .nav-link.active {
  background: transparent !important;
  color: var(--color-primary) !important;
  border-bottom-color: var(--color-primary) !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
}
.nav-tabs .nav-link:hover:not(.active) {
  border-color: transparent !important;
  color: var(--color-text) !important;
}

/* Spinner */
.spinner-border, .spinner-grow {
  color: var(--color-primary) !important;
}

/* =====================================================================
   RESPONSIVE
   ===================================================================== */
@media (max-width: 1199px) {
  .workspace-area { padding: 24px; }
  .app-header { padding: 0 24px; }
}

@media (max-width: 991px) {
  .sidebar {
    transform: translateX(-100%);
    box-shadow: var(--shadow-xl);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .sidebar-backdrop.open {
    opacity: 1;
    pointer-events: all;
  }

  .main-content {
    margin-left: 0 !important;
  }

  .btn-mobile-menu {
    display: flex;
  }

  .header-page-title { font-size: 0.9375rem; }
}

@media (max-width: 767px) {
  .workspace-area { padding: 16px; }
  .app-header { padding: 0 16px; height: 56px; }
  .page-header { margin-bottom: 16px; }
  .kpi-card { padding: 16px; }
  .kpi-value { font-size: 1.5rem; }
  .user-info-block { display: none; }
  .theme-switcher { display: none; }
  .auth-card { padding: 28px 20px; }
}

@media (max-width: 480px) {
  .page-header { flex-direction: column; }
  .page-header-right { width: 100%; }
  .page-header-right .btn { flex: 1; justify-content: center; }
}

/* =====================================================================
   FORM BUILDER CANVAS
   ===================================================================== */
.builder-canvas {
  background: var(--color-bg);
  border: 2px dashed var(--color-border);
  border-radius: var(--radius-lg);
  min-height: 200px;
  padding: 20px;
  transition: border-color 0.15s ease;
}

[data-theme="dark"] .glass-panel {
  background: #273449 !important;
  border-color: #374151 !important;
}

[data-theme="dark"] .builder-field-item {
  background: #1F2937 !important;
  border-color: #374151 !important;
}

[data-theme="dark"] .builder-canvas {
  background: #111827 !important;
  border-color: #374151 !important;
}

.builder-canvas.drag-over {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.builder-field-item {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  margin-bottom: 10px;
  cursor: grab;
  transition: var(--transition), box-shadow 0.15s ease;
  display: flex;
  align-items: center;
  gap: 12px;
}


.builder-field-item:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-sm);
}

/* =====================================================================
   ANALYTICS / CHARTS WRAPPER
   ===================================================================== */
.chart-wrapper {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-sm);
}

.chart-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16px;
}

/* =====================================================================
   TIMELINE (Status History)
   ===================================================================== */
.timeline { list-style: none; padding: 0; margin: 0; position: relative; }

.timeline::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--color-border);
}

.timeline-item {
  position: relative;
  padding-left: 40px;
  margin-bottom: 20px;
}

.timeline-dot {
  position: absolute;
  left: 6px;
  top: 4px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-primary);
  border: 3px solid var(--color-card);
  box-shadow: 0 0 0 2px var(--color-primary);
}

.timeline-dot.success { background: var(--color-success); box-shadow: 0 0 0 2px var(--color-success); }
.timeline-dot.danger  { background: var(--color-danger);  box-shadow: 0 0 0 2px var(--color-danger);  }
.timeline-dot.warning { background: var(--color-warning); box-shadow: 0 0 0 2px var(--color-warning); }
.timeline-dot.muted   { background: var(--color-text-muted); box-shadow: 0 0 0 2px var(--color-text-muted); }

.timeline-content {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  font-size: 0.875rem;
}

.timeline-time {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin-top: 4px;
}

/* =====================================================================
   NOTIFICATION ITEMS
   ===================================================================== */
.notification-item {
  display: flex;
  gap: 12px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--color-border);
  transition: background 0.12s ease;
  cursor: pointer;
}

.notification-item:hover { background: var(--sidebar-hover-bg); }
.notification-item.unread { background: var(--color-primary-light); }
.notification-item.unread:hover { background: rgba(79,70,229,0.15); }

.notification-icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
}

.notification-body { flex: 1; min-width: 0; }
.notification-title { font-size: 0.875rem; font-weight: 600; color: var(--color-text); }
.notification-msg   { font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 2px; }
.notification-time  { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 4px; }

/* =====================================================================
   ACCESSIBILITY
   ===================================================================== */
:focus-visible {
  outline: 2px solid var(--color-primary) !important;
  outline-offset: 2px !important;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border-width: 0;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}

/* =====================================================================
   GLOBAL DARK THEME TABLE OVERRIDES (SPECIFICITY PROOF)
   ===================================================================== */
[data-theme="dark"] table,
[data-theme="dark"] .table,
[data-theme="dark"] .table-row,
[data-theme="dark"] .data-table,
[data-theme="dark"] .list-table,
[data-theme="dark"] .card-table,
[data-theme="dark"] .submission-table,
[data-theme="dark"] .forms-table,
[data-theme="dark"] .table-responsive {
  background-color: #1F2937 !important;
  color: #F3F4F6 !important;
  border-color: #374151 !important;
}

[data-theme="dark"] table thead,
[data-theme="dark"] table thead tr,
[data-theme="dark"] table thead th,
[data-theme="dark"] .table thead th {
  background-color: #273449 !important;
  background: #273449 !important;
  color: #F3F4F6 !important;
  border-bottom-color: #374151 !important;
}

[data-theme="dark"] table tbody tr,
[data-theme="dark"] .table tbody tr {
  background-color: #1F2937 !important;
  background: #1F2937 !important;
  color: #F3F4F6 !important;
}

[data-theme="dark"] table tbody tr:nth-child(even),
[data-theme="dark"] .table tbody tr:nth-child(even) {
  background-color: #243244 !important;
  background: #243244 !important;
}

[data-theme="dark"] table tbody tr:hover,
[data-theme="dark"] .table tbody tr:hover {
  background-color: #2D4059 !important;
  background: #2D4059 !important;
}

[data-theme="dark"] table td,
[data-theme="dark"] table th,
[data-theme="dark"] .table td,
[data-theme="dark"] .table th {
  background-color: transparent !important;
  color: #F3F4F6 !important;
  border-color: #374151 !important;
}

[data-theme="dark"] table td strong,
[data-theme="dark"] .table td strong {
  color: #F3F4F6 !important;
}

[data-theme="dark"] table td a,
[data-theme="dark"] .table td a {
  color: #60A5FA !important;
}

[data-theme="dark"] table td a:hover,
[data-theme="dark"] .table td a:hover {
  color: #93C5FD !important;
}

[data-theme="dark"] .text-muted,
[data-theme="dark"] table td .text-muted,
[data-theme="dark"] .table td .text-muted,
[data-theme="dark"] small.text-muted {
  color: #9CA3AF !important;
}

[data-theme="dark"] table td .badge,
[data-theme="dark"] .table td .badge {
  border: none !important;
}

/* =====================================================================
   CUSTOM MODAL DIALOG STYLES
   ===================================================================== */
.app-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1050;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.15s linear;
}

.app-modal.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.app-modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(17, 24, 39, 0.7);
  backdrop-filter: blur(4px);
  z-index: 1;
}

.app-modal-dialog {
  position: relative;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  width: 100%;
  max-width: 500px;
  box-shadow: var(--shadow-xl);
  z-index: 2;
  margin: 16px;
}

.app-modal-header {
  border-bottom: 1px solid var(--color-border);
  padding-bottom: 12px;
  margin-bottom: 12px;
}


